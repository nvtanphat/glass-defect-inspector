# Copy to inspector.env and use docker compose --env-file inspector.env.
# Preserve an existing .env containing research credentials.
POSTGRES_DB=inspector
POSTGRES_USER=inspector
POSTGRES_PASSWORD=replace-with-a-random-password
INSPECTOR_API_TOKEN=replace-with-a-random-internal-token
DATABASE_URL=postgresql+psycopg://inspector:replace-with-a-random-password@127.0.0.1:5432/inspector
INSPECTOR_STORAGE=var/inspections
INSPECTOR_HOST=127.0.0.1
INSPECTOR_PORT=8501
